{
  "schemaVersion": 1,
  "ruleId": "claude.electron.protected",
  "version": "0.1.0",
  "sourceReference": "docs/LOCAL_STORAGE_REVIEW.md; docs/PRODUCT_BLUEPRINT.md section 6",
  "fingerprint": { "appId": "Claude", "versions": ["unverified"] },
  "allowedRelativePaths": [
    "AppData\\Roaming\\Claude\\Local Storage",
    "AppData\\Roaming\\Claude\\IndexedDB",
    "AppData\\Roaming\\Claude\\Session Storage",
    "AppData\\Roaming\\Claude\\Network\\Cookies"
  ],
  "category": "user-data",
  "trust": "inventory-only",
  "blockers": ["protected-path", "owner-process-active"],
  "processes": { "owners": ["Claude.exe"], "helpers": [] },
  "requiredEvidence": ["protection-rule-removed-by-user-decision"],
  "regenerationCost": "high",
  "recoveryPolicy": "not-recoverable"
}
